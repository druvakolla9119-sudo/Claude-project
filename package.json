{
  "name": "sensor-report-system",
  "version": "3.0.0",
  "description": "Converts raw microcontroller/sensor telemetry into high-level PDF reports",
  "main": "server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.js",
    "simulate": "node examples/simulate-device.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "pdfkit": "^0.15.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "optionalDependencies": {
    "mqtt": "^5.10.0"
  }
}
